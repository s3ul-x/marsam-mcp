{
  "name": "@marsam/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server for the Marsam painting studio: draw, compose layers and export images from any MCP client.",
  "type": "module",
  "bin": {
    "marsam-mcp": "dist/server.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@napi-rs/canvas": "^0.1.80",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.9"
  }
}
